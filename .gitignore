# --- Node / Javascript ---
# Matches node_modules in root and all subfolders (client, server, worker)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Environment / Secrets ---
# Keep your API keys and secrets out of Git
.env
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Docker ---
# Ignore the data persisted by databases if you add volumes later
# e.g., if you add a postgres or redis container
pgdata/
redisdata/

# --- IDE / Operating System ---
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Production Builds ---
# Ignore build folders generated by the client (React/Vite/etc)
client/build/
client/dist/